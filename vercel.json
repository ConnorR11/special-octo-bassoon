{
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/google-reviews/sync",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/google-reviews/reconcile",
      "schedule": "0 * * * *"
    }
  ]
}
